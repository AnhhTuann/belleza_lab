# ============================================================
# Belleza Lab - Production .env
# ============================================================

# Generate: openssl rand -hex 32
POSTGRES_PASSWORD="replace_with_random_hex_password"

# Gemini API Key (chỉ dùng bên backend, không gửi về browser)
GEMINI_API_KEY="replace_with_gemini_api_key"

# Generate: openssl rand -base64 32 (ít nhất 32 ký tự)
BETTER_AUTH_SECRET="replace_with_random_secret_at_least_32_chars"
BETTER_AUTH_URL="https://bellezalab.duckdns.org"
APP_URL="https://bellezalab.duckdns.org"

# Docker Compose tự override host thành 'postgres' container
DATABASE_URL="postgresql://belleza:replace_with_random_hex_password@localhost:5432/belleza"

# Ngân sách AI hàng tháng (USD)
AI_MONTHLY_BUDGET_USD="5"
GEMINI_INPUT_BUDGET_RATE_PER_MILLION_USD="0.5"
GEMINI_OUTPUT_BUDGET_RATE_PER_MILLION_USD="3"

# Port backend (Docker Compose set mặc định 3000)
# APP_PORT="3000"
