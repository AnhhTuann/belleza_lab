{
  "name": "belleza-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:server\" \"vite\"",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run db:migrate:auth && tsx server/index.ts",
    "server": "npm run db:migrate:auth && tsx watch server/index.ts",
    "db:migrate:auth": "auth migrate --yes --config ./server/auth.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/genai": "^1.29.0",
    "@mui/material": "^9.0.0",
    "auth": "^1.7.25",
    "better-auth": "^1.7.25",
    "browser-image-compression": "^2.0.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.7",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
